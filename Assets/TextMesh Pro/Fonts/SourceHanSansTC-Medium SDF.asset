    characterSetSelectionMode: 7
    characterSequence: "\u5341\u4E5D\u4E16\u7D00\u672B\u7684\u53F0\u7063\uFF0C\u96D6\u7136\u662F\u6E05\u5E1D\u570B\u6BEB\u4E0D\u91CD\u8996\u7684\u4E00\u500B\u89D2\u843D\t\r\n\u537B\u56E0\u70BA\u8336\u8449\u7684\u8208\u8D77\uFF0C\u8E8D\u4E0A\u570B\u969B\u821E\u53F0\t\r\n\u90A3\u500B\u5E74\u4EE3\u7684\u5927\u7A3B\u57D5\uFF0C\u662F\u8336\u9999\u56DB\u6EA2\u7684\u6E2F\u53E3\uFF0C\u662F\u53F0\u7063\u8207\u5168\u7403\u76F8\u9047\u7684\u5730\u65B9\t\r\n\u4F86\u81EA\u798F\u723E\u6469\u6C99\u7684\u6771\u65B9\u7F8E\u4EBA\u8336\uFF0C\u5F9E\u9019\u88E1\u51FA\u767C\uFF0C\u8D70\u5411\u5168\u4E16\u754C\t\r\n\u5927\u7A3B\u57D5\uFF0C\u4E00\u500B\u7A2E\u7A3B\u7C73\u7684\u5730\u65B9\t\r\n\u96A8\u8457\u773E\u591A\u5192\u96AA\u8005\u7684\u4F86\u5230\uFF0C\u5404\u5F0F\u5404\u6A23\u7684\u5922\u60F3\uFF0C\u90FD\u80FD\u5728\u6B64\u6210\u771F\t\r\n1858\u5E74\u7684\u5929\u6D25\u689D\u7D04\uFF0C\u903C\u8FEB\u9060\u5728\u5317\u4EAC\u7684\u54B8\u8C50\u7687\u5E1D\u6253\u958B\u4E86\u53F0\u7063\u5317\u7AEF\u7684\u6DE1\u6C34\u6E2F\t\r\n\u5F9E\u6B64\uFF0C\u897F\u65B9\u5404\u570B\u958B\u59CB\u5728\u5927\u7A3B\u57D5\u6210\u7ACB\u5546\u884C\t\r\n\u5728\u9019\u500B\u4E00\u5207\u90FD\u6709\u53EF\u80FD\u7684\u5730\u65B9\t\r\n\u56E0\u70BA\u4E09\u500B\u5192\u96AA\u8005\u7684\u4F86\u5230\uFF0C\u5927\u7A3B\u57D5\u51FA\u53E3\u7684\u8336\u8449\u5411\u4E16\u754C\u5C55\u793A\u51FA\u5168\u65B0\u7684\u98A8\u8C8C\t\r\n\u5C31\u7B97\u4F60\u4E0D\u5E38\u559D\u53F0\u7063\u8336\uFF0C\u6216\u8005\u4F60\u4E0D\u559C\u611B\u5192\u96AA\uFF0C\u90FD\u6C92\u6709\u95DC\u4FC2\t\r\n\u6E05\u4EE3\u7684\u5927\u7A3B\u57D5\uFF0C\u5979\u7684\u5149\u8292\u96A8\u6642\u90FD\u7B49\u5F85\u8457\u53BB\u767C\u73FE\t\r\n\u9019\u6BB5\u6B77\u53F2\uFF0C\u662F\u53F0\u7063\u7B2C\u4E00\u500B\u8F5F\u52D5\u5168\u7403\u7684\u8CBF\u6613\u50B3\u5947\t\r\n\u800C\u6545\u4E8B\uFF0C\u662F\u5F9E\u4E00\u500B\u5C11\u5973\u8207\u8336\u8449\u7684\u9023\u7D50\u958B\u59CB\u2026\u2026\t\r\n\u807D\u898B\u8072\u97F3\u4E86\u55CE\t\r\n\u5979\u662F\u4F86\u81EA\u798F\u5EFA\u5B89\u6EAA\u7684\u5929\u624D\u88FD\u8336\u5E2B\uFF0C\u9B4F\u82B7\u96F2\t\r\n\u963F\u96F2\u4ED4\uFF0C\u4F60\u906E\u723E\u4ED4\u7D30\u6F22\u7684\u67E5\u67D0\u56E1\u4ED4\t\u963F\u96F2\u4ED4\uFF0C\u4F60\u9019\u9EBC\u5E74\u8F15\u7684\u5C0F\u5973\u751F\r\nu\xEC\u5510\u5C71\u5230\u53F0\u7063\uFF0C\u6562\u8B1B\u5FC3\u5167\u650F\u8882\u9A5A\t\u5F9E\u5510\u5C71\u5230\u53F0\u7063\uFF0C\u96E3\u9053\u8AAA\u4F60\u5FC3\u88E1\u90FD\u4E0D\u6703\u6015\u55CE\r\n\u5C0F\u5BE1\uFF0C\u6BCB\u904E\u6211\u4E00\u76F4\u5411\u671B\u9059\u9060\u7684\u6240\u5728\t\u7A0D\u5FAE\uFF0C\u4E0D\u904E\u6211\u4E00\u76F4\u56AE\u5F80\u9059\u9060\u7684\u6240\u5728\r\n\u6D0B\u5927\u4EBA\u4F6E\u674E\u5148\u751F\u8B1B\u904E\t\u6D0B\u5927\u4EBA\u8DDF\u674E\u5148\u751F\u8B1B\u904E\r\nin\u6709\u4FE1\u5FC3\uFF0C\u5C07\u6211\u505A\u7684\u8336\u737B\u4E88\u82F1\u570B\u5973\u738B\t\u4ED6\u6709\u4FE1\u5FC3\uFF0C\u5C07\u6211\u505A\u7684\u8336\u737B\u4E88\u82F1\u570B\u5973\u738B\r\n\u6211\u7684\u8EAB\u8EC0\u53EA\u80FD\u5920\u5230\u53F0\u7063\uFF0C\u6BCB\u904E\u6211\u7684\u8336\u6703\u4F7F\u884C\u5230\u64F1kap
      \u9060\u7684\u6240\u5728\t\u6211\u7684\u8EAB\u8EC0\u53EA\u80FD\u5920\u5230\u53F0\u7063\uFF0C\u4E0D\u904E\u6211\u7684\u8336\u53EF\u4EE5\u8D70\u5230\u66F4\u9060\u7684\u6240\u5728\r\n\u60F3\u5230\u906E\uFF0C\u6211\u5C31\u4EC0\u9EBC\u650F\u5514\u9A5A\u77E3\t\u60F3\u5230\u9019\uFF0C\u6211\u5C31\u4EC0\u9EBC\u90FD\u4E0D\u6015\u4E86\r\n\u9019\u88E1\u5C31\u662F\u5927\u7A3B\u57D5\u7684\u5BF6\u9806\u6D0B\u884C\uFF0C\u662F\u963F\u96F2\u4ED4\u53E3\u4E2D\u7684\u6D0B\u5927\u4EBAJohn
      Dodd \u5EFA\u84CB\u7684\t\r\n\u4ED6\u548C\u6625\u751F\u5148\u751F\u5728\u5B89\u6EAA\u8207\u5979\u76F8\u9047\u4E4B\u5F8C\uFF0C\u5169\u4F4D\u7537\u58EB\u5C31\u6C7A\u5B9A\u4F86\u53F0\u7063\u8CE3\u8336\t\r\n\u96A8\u5F8C\u6D0B\u884C\u4E5F\u84CB\u51FA\u4F86\u4E86\t\r\n\u674E\u6625\u751F\uFF0C\u662F\u4F86\u81EA\u5EC8\u9580\uFF0C\u662F\u5EC8\u9580\u7684\u8CB7\u8FA6\t\r\n\u4ED6\u662F\u8654\u8AA0\u7684\u57FA\u7763\u5F92\uFF0C\u4F86\u53F0\u7063\u7684\u76EE\u7684\uFF0C\u8207\u5176\u8AAA\u662F\u7D93\u5546\t\r\n\u4ED6\u66F4\u60F3\u5728\u9019\u88E1\u8208\u5EFA\u6559\u5802\uFF0C\u8DDF\u9019\u5EA7\u5CF6\u5DBC\u5206\u4EAB\u57FA\u7763\u7684\u611B\t\r\n\u4F60\u9F3B\u770B\u8993\uFF0C\u9019\u662F\u4EC0\u9EBC\u8336\t\u4F60\u805E\u805E\u770B\uFF0C\u9019\u662F\u4EC0\u9EBC\u8336\r\n\u6562\u82E5\u6BCB\u662F\u5B89\u6EAA\u9435\u89C0\u97F3\uFF0C\u61C9\u8A72\u662F\u9032\u524D\u4F60\u8B1B\u904E\u7684\u70CF\u9F8D\u8336\uFF0C\u53F0\u7063\u70CF\u9F8D\u8336\t\u61C9\u8A72\u4E0D\u662F\u5B89\u6EAA\u9435\u89C0\u97F3\uFF0C\u61C9\u8A72\u662F\u4F60\u4E4B\u524D\u8B1B\u904E\u7684\u70CF\u9F8D\u8336\uFF0C\u53F0\u7063\u7684\u70CF\u9F8D\u8336\r\n\u64F1\u8B1B\u4F60\u6BCB\u634C\u8336\t\u9084\u8AAA\u4F60\u4E0D\u61C2\u8336\r\n\u54A7\u8336\u4ED9\u5B50\u9762\u982D\u524D\uFF0C\u8AB0\u4EBA\u6562\u8B1B\u5BB6\u5DF1\u634C\u8336\t\u5728\u8336\u4ED9\u5B50\u7684\u9762\u524D\uFF0C\u8AB0\u6562\u8B1B\u81EA\u5DF1\u61C2\u8336\r\n\u9B4F\u82B7\u96F2\u5C31\u662F\u5982\u6B64\uFF0C\u8B1B\u5230\u8336\uFF0C\u7121\u8A71\u4E0D\u8AC7\uFF1B\u8B1B\u5230\u81EA\u5DF1\u7684\u6642\u5019\uFF0C\u99AC\u4E0A\u6C89\u9ED8\t\r\n\u6216\u8A31\u6B63\u56E0\u5982\u6B64\uFF0C\u674E\u6625\u751F\u624D\u6703\u5728\u81EA\u5DF1\u7684\u7B46\u8A18\u672C\u88E1\u4E0A\uFF0C\u8A18\u4E0B\u9B4F\u82B7\u96F2\u7684\u6240\u6709\u8A00\u8A9E\t\r\n\u8336\u4ED9\u5B50\uFF0CFairy
      of Tea\t\r\n\u662F\u4ED6\u7684\u5408\u5925\u4EBA\uFF0C\u4E5F\u662F\u9019\u9593\u5BF6\u9806\u6D0B\u884C\u7684\u8001\u95C6\u7D04\u7FF0\xB7\u9676\u5FB7\t\r\n\u5728\u5B89\u6EAA\u559D\u4E0B\u7B2C\u4E00\u53E3\u9B4F\u82B7\u96F2\u6CE1\u7684\u8336\u4E4B\u5F8C\u7D66\u5979\u53D6\u7684\u5916\u865F\t\r\n\u9676\u5FB7\u73FE\u5728\u4EBA\u5C31\u5728\u6D0B\u884C\u7684\u5927\u5EF3\t\r\n\u7D04\u7FF0\xB7\u9676\u5FB7\u4F86\u81EA\u8607\u683C\u862D\uFF0C\u5728\u5EC8\u9580\u5C45\u4F4F\u4E86\u5F88\u591A\u5E74\t\r\n\u4ED6\u4E0D\u76F8\u4FE1\u9D09\u7247\u662F\u4ED6\u5728\u6771\u65B9\u7684\u672A\u4F86\uFF0C\u65BC\u662F\u96E2\u958B\u539F\u672C\u7684\u5DE5\u4F5C\u7684\u6021\u548C\u6D0B\u884C\t\r\n\u674E\u6625\u751F\u544A\u8A34\u4ED6\uFF0C\u5317\u53F0\u7063\u7684\u4E18\u9675\uFF0C\u662F\u7A2E\u690D\u8336\u8449\u7684\u8655\u5973\u5730\t\r\n\u8336\u4ED9\u5B50\u7684\u51FA\u73FE\uFF0C\u8B93\u9676\u5FB7\u6C7A\u5B9A\u535A\u4E00\u628A\t\r\n\u4ED6\u76F8\u4FE1\u81EA\u5DF1\u7D55\u5C0D\u80FD\u7528\u53F0\u7063\u8336\u81F4\u5BCC\t\r\n\u4E26\u627F\u8AFE\u9B4F\u82B7\u96F2\u7E3D\u6709\u4E00\u5929\u6703\u8B93\u82F1\u570B\u5973\u738B\u4E5F\u559D\u4E0A\u4E00\u53E3\u4ED6\u5011\u7684\u8336\t\r\n\u5728\u5C31\u5230\u6211\u7684\u6D0B\u884C\u88E1\u56DB\u8655\u901B\u901B\u5427\t\r\n\u9019\u88E1\u554A\uFF0C\u9664\u4E86\u6211\u548C\u674E\u5148\u751F\uFF0C\u548C\u4E00\u4E9B\u5EC8\u9580\u4F86\u7684\u540C\u4E8B\uFF0C\u5E7E\u500B\u82F1\u570B\u4EBA\u4EE5\u5916\t\r\n\u5176\u4ED6\u5462\u4E0D\u7BA1\u662F\u5927\u5EF3\u7684\u63A5\u5F85\u4EBA\u54E1\uFF0C\u6216\u8005\u9084\u662F\u5916\u9762\u9577\u5ECA\u6B63\u5728\u64BF\u62FE\u8336\u6897\u7684\u5973\u58EB\t\r\n\u5168\u90E8\u963F\uFF0C\u90FD\u662F\u53F0\u5317\u7684\u7576\u5730\u4EBA\uFF0C\u66F4\u5225\u4E0D\u7528\u8AAA\u90A3\u4E9B\u548C\u6211\u5408\u4F5C\u7684\u8FB2\u4EBA\u4E86\t\r\n\u8336\u8449\uFF0C\u7D66\u4E86\u4ED6\u5011\u5DE5\u4F5C\uFF0C\u4E5F\u7D66\u4E86\u6211\u4E00\u500B\u5922\t\r\n\u8336\u8449\u5C31\u662F\u95DC\u65BC\u5E78\u798F\u7684\u8449\u5B50\t\r\n\u5305\u88DD\u597D\u7684\u8336\u8449\u88DD\u9032\u8336\u7BB1\t\r\n\u8336\u7BB1\u4E0A\u9664\u4E86\u6709\u5546\u6A19\u7684\u540D\u5B57\t\r\n\u9676\u5FB7\u9084\u7279\u5730\u5728\u7BB1\u5B50\u4E0A\u5370\u4E0A\u4E00\u500B\u9B4F\u82B7\u96F2\u7684\u5074\u81C9\t\r\n\u9019\u8B93\u963F\u96F2\u4ED4\u5BE6\u5728\u662F\u611F\u5230\u5BB3\u81CA\t\r\n\u5370\u8457\u8336\u4ED9\u5B50\u9762\u5BB9\u7684\u53F0\u7063\u70CF\u9F8D\u8336\t\r\n\u5F9E\u5927\u7A3B\u57D5\u958B\u59CB\u9001\u5F80\u6DE1\u6C34\u548C\u57FA\u9686\t\r\n\u7136\u5F8C\u518D\u53BB\u5230\u66F4\u9060\u7684\u5730\u65B9\t\r\n\u9B4F\u82B7\u96F2\u5FC3\u795E\u56AE\u5F80\u7684\u9060\u65B9\t\r\n\u5C0D\u9B4F\u82B7\u96F2\u800C\u8A00\uFF0C\u6700\u9059\u9060\u7684\u5730\u65B9\u4E0D\u662F\u53F0\u7063\uFF0C\u800C\u662F\u5728\u90A3\u689D\u7A7F\u8D8A\u9ED1\u6C34\u6E9D\u7684\u8239\u4E0A\t\r\n\u516D\u6B7B\u4E09\u7559\u4E00\u56DE\u982D\t\r\n\u6771\u5357\u6CBF\u6D77\u7684\u4E2D\u570B\u4EBA\u4F86\u5230\u53F0\u7063\u4E4B\u524D\uFF0C\u5F80\u5F80\u90FD\u662F\u62FF\u8457\u81EA\u5DF1\u7684\u751F\u547D\u7576\u8CED\u6CE8\t\r\n\u5EC8\u9580\u5F80\u6DE1\u6C34\u7684\u90A3\u689D\u8239\u66FE\u7D93\u9047\u898B\u4E00\u689D\u9BE8\u9B5A\uFF0C\u8B93\u8239\u8EAB\u5728\u5927\u96E8\u4E2D\u5287\u70C8\u6643\u52D5\t\r\n\u9B4F\u82B7\u96F2\u7DCA\u7DCA\u6293\u8457\u5305\u88B1\u88E1\u7684\u89C0\u97F3\u83E9\u85A9\u50CF\t\r\n\u5167\u5FC3\u6050\u61FC\u8457\u6B7B\u4EA1\uFF0C\u6A23\u5B50\u7336\u5982\u8336\u6E6F\u822C\u5730\u5E73\u975C\t\r\n\u5BF6\u9806\u6D0B\u884C\u6210\u70BA\u90A3\u6642\u5019\u5927\u7A3B\u57D5\u6700\u71B1\u9B27\u7684\u6240\u5728\t\r\n\u5E6B\u5FD9\u505A\u8336\u7684\u5A66\u4EBA\u5750\u5728\u8D70\u5ECA\u4E0A\uFF0C\u524D\u4F86\u54C1\u8336\u7684\u6D0B\u4EBA\u6216\u53F0\u7063\u7D33\u58EB\uFF0C\u628A\u8336\u8449\u88DD\u9032\u7BB1\u5B50\u7684\u5DE5\u4EBA\t\r\n1880\u5E74\u4EE3\uFF0C\u5927\u7A3B\u57D5\uFF0C\u9023\u8ECA\u592B\u8173\u5E95\u4E0B\u7684\u6CE5\u571F\u5370\uFF0C\u90FD\u5145\u6EFF\u4E86\u8336\u9999\t\r\n\u73FE\u5728\u5728\u4F60\u9762\u524D\u7684\u5C31\u662F\u53F0\u7063\u70CF\u9F8D\u8336\uFF0C150\u5E74\u904E\u4E86\uFF0C\u6A5F\u68B0\u53D6\u4EE3\u4E86\u8A31\u591A\u4EBA\u5DE5\t\r\n\u4E0D\u904E\u9084\u662F\u53D6\u4EE3\u4E0D\u4E86\u8336\u4E4B\u70BA\u8336\uFF0C\u672C\u8EAB\u7684\u6E05\u9999\t\r\n\u9019\u88E1\u6709\u4E00\u676F\u8336\uFF0C\u4EE5\u53CA\u4E00\u4E9B\u6642\u9593\uFF0C\u90FD\u662F\u4F60\u7684\t\r\n\u6211\u5011\u559D\u8336\u5427\t\r\n\u963F\u96F2\u4ED4\uFF1F\u963F\u96F2\u4ED4\uFF1F\u963F\u96F2\u2026\t\r\n\u674E\u5148\u751F\uFF0C\u4F60\u4E0D\u662F\u61C9\u8A72\u8981\u8CAC\u5099\u6211\u600E\u9EBC\u53C8\u5728\u9157\u9152\u4E86\u55CE\t\r\n\u9676\u5FB7\u5148\u751F\uFF0C\u4E0A\u5E1D\u5728\u770B\u9867\u6211\u5011\u554A\uFF0C\u5728\u53F0\u5317\u4EE5\u5916\u7684\u5730\u65B9\u6211\u7D42\u65BC\u627E\u5230\u8336\u8449\u4E86\t\r\n\u75FE\u2026\u4F46\u662F\u554A\uFF0C\u6211\u5F97\u8AAA\u5F97\u8981\u9B4F\u5C0F\u59D0\u770B\u904E\u4E86\uFF0C\u624D\u80FD\u7B97\u662F\u597D\u6D88\u606F\t\r\n\u963F\u96F2\u4ED4\t\r\n\u4EC0\u9EBC\u4EE3\u8A8C\t\u4EC0\u9EBC\u4E8B\u60C5\r\n\u6211\u8DDF\u4F60\u8B1B\u9F41\uFF0C\u6211\u9F41\uFF0C\u5C0D\u4E09\u89D2\u6E67\u6CBF\u8DEF\u554F\uFF0C\u554A\u650F\u554F\u7121\u5566\t\u6211\u8DDF\u4F60\u8B1B\u9F41\uFF0C\u6211\u5F9E\u4E09\u89D2\u6E67\u6CBF\u8DEF\u554F\uFF0C\u90FD\u554F\u4E0D\u5230\r\n\u554F\u5230\u5317\u57D4\u624D\u7E3D\u7B97\u4E4E\u6211\u63E3\u8457\u554A\uFF0C\u73FE\u633D\u7684\u8336\u83DC\t\u554F\u5230\u5317\u57D4\u7E3D\u7B97\u624D\u7D66\u6211\u627E\u5230\u73FE\u63A1\u7684\u8336\u83DC\r\n\u62BC\u6BCB\u95A3\u56E0\u7684\u7E3D\u6CC1\uFF0C\u6211\u611F\u89BA\u4F60\u4E00\u5B9A\u6703\u68C4\u5ACC\t\u4E0D\u904E\u5B83\u5011\u7684\u72C0\u6CC1\u2026\u6211\u611F\u89BA\u4F60\u4E00\u5B9A\u6703\u5ACC\u68C4\r\n\u6211\u5148\u770B\u624D\u8B1B\t\u6211\u5148\u770B\u518D\u8B1B\r\n\u54C7\t\r\n\u5DF2\u7D93\u4E00\u5E74\u591A\u6C92\u6709\u770B\u898B\u88DD\u6EFF\u8336\u8449\u7684\u888B\u5B50\u4E86\t\r\n\u662F\u554A\uFF0C\u4F46\u662F\u554A\t\r\n\u5B83\u5011\u7684\u6A23\u5B50\uFF0C\u6211\u5F97\u8AAA\u4E0D\u592A\u6A02\u89C0\t\r\n\u888B\u5B50\u6253\u4E88\u958B\uFF0C\u770B\u8336\t\u628A\u888B\u5B50\u6253\u958B\uFF0C\u770B\u8336\u5566\r\n\u4F60\u770B\uFF0C\u53EA\u8CF0\u9019\u6279\u8336\u662F\u6309\u4F60\u8981\u6C42\u7684\u6642\u8FB0\u633D\u7684\t\u4F60\u770B\u9F41\uFF0C\u53EA\u5269\u9019\u6279\u8336\u662F\u6309\u7167\u4F60\u8981\u6C42\u7684\u6642\u8FB0\u63A1\u7684\r\n\u554A\u7D50\u679C\u54E9\uFF0C\u6211\u4E00\u770B\u650F\u7E3D\u8457\u6D8E\u77E3\uFF0C\u8336\u83DC\u5168\u90E8\u7CFE\u4F6E\u9019\u5F62\t\u554A\u7D50\u679C\u5462\uFF0C\u6211\u4E00\u770B\u5168\u90FD\u8457\u6D8E\u4E86\uFF0C\u8336\u83DC\u5168\u90E8\u90FD\u7E2E\u6210\u9019\u5F62\u72C0\u4E86\r\n\u5B83\u5011\u770B\u8D77\u4F86\u5C31\u50CF\u662F\u60E1\u9B54\u7684\u6307\u7532\u4E00\u6A23\t\r\n\u771F\u6B63\u650F\u8457\u6D8E\u77E3\t\u771F\u7684\u90FD\u8457\u6D8E\u4E86\r\n\u5C0D\u554A\u2026\t\u5C0D\u554A\u2026\r\n\u5C31\u7B97\u8336\u5FC3\u505A\u597D\u52E2\uFF0C\u561B\u662F\u92B7\u8882\u51FA\u53BB\u7684\u5566\t\u6240\u4EE5\u5C31\u7B97\u6211\u5011\u7684\u8336\u5FC3\u505A\u5F97\u597D\uFF0C\u53EF\u80FD\u4E5F\u662F\u92B7\u4E0D\u51FA\u53BB\u5566\r\n\u8AB0\u6B32\u8CB7\u8457\u6D8E\u7684\u8336\t\u8AB0\u6703\u8CB7\u8457\u6D8E\u7684\u8336\r\n\u674E\u5148\u751F\uFF0C\u4F60\u62C4\u624D\u8B1B\u5317\u57D4\u7684\u8336\u5C71\u4ED4(t\xEA-suann-\xE1)
      \u5C31\u7B97\u770B\u5230\u8336\u83DC\u5DF2\u7D93\u8457\u6D8E\t\u674E\u5148\u751F\uFF0C\u4F60\u525B\u624D\u8B1B\u5317\u57D4\u7684\u8336\u5C71\u4ED4\u5C31\u7B97\u770B\u5230\u8336\u83DC\u5DF2\u7D93\u8457\u6D8E\r\n\u7336\u539F\u54A7\u6211\u8981\u6C42\u7684\u6642\u8FB0\u633D\u4E88\u4F60\t\u537B\u4F9D\u7136\u5728\u6211\u8981\u6C42\u7684\u6642\u8FB0\u63A1\u7D66\u4F60\r\n\u5C31\u9000\u56DE\u53BB\u5427\t\r\n\u8CB7\u843D\u4F86\t\u628A\u5B83\u8CB7\u4E0B\u4F86\r\n\u89AA\u611B\u7684\u8336\u4ED9\u5B50\uFF0C\u4F60\u760B\u4E86\u55CE\uFF0C\u9019\u8336\u9577\u5F97\u90A3\u9EBC\u919C\t\r\n\u4F60\u6562\u76F8\u4FE1\u6211\t\u4F60\u9858\u610F\u76F8\u4FE1\u6211\u55CE\r\n\u6211\u76F8\u4FE1\u4F60\t\u597D\uFF0C\u6211\u76F8\u4FE1\u4F60\r\n\u591A\u8B1D\uFF0C\u8D95\u7DCA\u63D0\u53BB\u66DD\u4E88\u8EDFpha\u030Dk
      h\u014Do n\u0144g\t\u8B1D\u8B1D\uFF0C\u8D95\u7DCA\u53BB\u628A\u5B83\u5011\u66EC\u8EDF\r\n\u6211\u662F\u4F60\u982D\u5BB6\uFF0C\u6211\u8B1B\uFF0C\u628A\u8336\u9000\u56DE\u53BB\t\u6211\u662F\u4F60\u8001\u95C6\uFF0C\u6211\u8B1B\uFF0C\u628A\u8336\u2026\u90FD\u9000\u56DE\u53BB\r\n\u9676\u5FB7\uFF0C\u4F60\u9019\u6A23\u5B50\u6709\u5FC5\u8981\u9019\u6A23\u55CE\t\r\n\u6211\u5DF2\u7D93\u6C92\u9322\u4E86\t\r\n\u9019\u4E9B\u8336\u90FD\u662F\u5F88\u4FBF\u5B9C\u7684\t\r\n\u674E\u5148\u751F\uFF0C\u6211\u662F\u9152\u9B3C\u4F46\u6211\u4E0D\u662F\u4E00\u500B\u8CED\u5F92\t\r\n\u6211\u8AAA\u6211\u6C92\u9322\u5C31\u662F\u6211\u771F\u7684\u6C92\u9322\u4E86\t\r\n\u6211\u73FE\u5728\u9023\u4E00\u5F35\u56DE\u5BB6\u7684\u8239\u7968\u90FD\u6709\u53EF\u80FD\u8CB7\u4E0D\u8D77\t\r\n\u4F5C\u70BA\u6211\u7684\u5408\u5925\u4EBA\uFF0C\u4F60\u5FC5\u9808\u8981\u539F\u8AD2\u6211\u7684\u61E6\u5F31\t\r\n\u5728\u6211\u548C\u4ED6\u4E4B\u9593\uFF0C\u4F60\u5FC5\u9808\u8981\u9078\u4E00\u908A\u7AD9\t\r\n\u597D\u2026\u90A3\u4ECA\u5929\u9019\u4E9B\u8336\u8449\t\r\n\u6211\u7528\u6211\u81EA\u5DF1\u7684\u9322\u8CB7\t\r\n\u4F60\u7684\u9322\t\r\n\u4F60\u554A\uFF0C\u70BA\u4E86\u84CB\u6559\u5802\u9023\u767D\u7C73\u90FD\u6368\u4E0D\u5F97\u5403\uFF0C\u4F60\u5C11\u7528\u9019\u62DB\u9A19\u6211\u653E\u4E0B\u69CD\u554A\t\r\n\u6211\u6559\u5802\u4EC0\u9EBC\u6642\u5019\u84CB\u90FD\u53EF\u4EE5\uFF0C\u6211\u4ECA\u5929\u6211\u7684\u670B\u53CB\u6709\u96E3\u6211\u5C31\u8981\u4ECA\u5929\u2026
      \t\r\n\u963F\u96F2\u4ED4\uFF0C\u5371\u96AA\t\u963F\u96F2\u4ED4\uFF0C\u5371\u96AA\r\n\u6211\uFF0C\u5B89\u6EAA\u9B4F\u5BB6\u67E5\u67D0\u56DD\u9B4F\u82B7\u96F2\uFF0C\u7528\u6211\u7684\u6027\u547D\u505A\u64D4\t\u6211\uFF0C\u5B89\u6EAA\u9B4F\u5BB6\u7684\u5973\u5152\u9B4F\u82B7\u96F2\uFF0C\u7528\u6211\u7684\u6027\u547D\u64D4\u4FDD\r\n\u6211\u6703\u6210\u529F\t\u6211\u6703\u6210\u529F\r\n\u597D\uFF0C\u6211\u76F8\u4FE1\u4F60\t\u597D\uFF0C\u6211\u76F8\u4FE1\u4F60\r\n\u6191\u4EC0\u9EBC\u4E00\u500B\u5C11\u5973\u80FD\u5920\u6709\u9019\u6A23\u7684\u773C\u795E\t\r\n\u4ED6\u662F\u4EC0\u9EBC\u8056\u5973\u8C9E\u5FB7\u55CE\t\r\n\u4ED6\u5ABD\u7684\uFF0C\u6211\u600E\u9EBC\u6703\u62FF\u6CD5\u570B\u4EBA\u4F86\u8209\u4F8B\u5B50\u554A\t\r\n\u63A5\u4E0B\u4F86\uFF0C\u6211\u6703\u626E\u6F14\u4E00\u500B\u56B4\u683C\u7684\u897F\u6D0B\u8CB7\u5BB6\t\r\n\u4F60\u5011\u7684\u4EFB\u52D9\u5F88\u7C21\u55AE\uFF0C\u505A\u51FA\u597D\u8336\u8B93\u6211\u638F\u9322\t\r\n\u962E\u76F8\u4FE1\u4F60\u662F\u6709\u5F71\uFF0C\u6BCB\u95A3\u962E\u7336\u539F\u662F\u4F60\u7684\u982D\u5BB6\uFF0C\u4F60\u561B\u5C0F\u5BE1\u4E88\u962E\u4E00\u500B\u4EA4\u4EE3\t\u6211\u5011\u76F8\u4FE1\u4F60\u662F\u771F\u7684\uFF0C\u4E0D\u904E\u6211\u5011\u4ECD\u7136\u662F\u4F60\u7684\u8001\u95C6\uFF0C\u4F60\u4E5F\u7A0D\u5FAE\u7D66\u6211\u5011\u4E00\u500B\u4EA4\u4EE3\r\n\u54B1\u9032\u524D\u6562\u6709\u9032\u904E\u5317\u57D4\u7684\u8336\u83DC\t\u6211\u5011\u4E4B\u524D\uFF0C\u6709\u9032\u904E\u5317\u57D4\u7684\u8336\u83DC\u55CE\r\n\u6C92\u6709\t\r\n\u6211\u6BCB\u662F\u6BCB\u634C\u770B\u904E\u4E88\u8712\u4ED4\u54AC\u904E\u7684\u8457\u6D8E\u8336\uFF0C\u7336\u6BCB\u904E\u9019\u6279phue\u8336\u8AA0\u5947\u602A\t\u6211\u4E0D\u662F\u6C92\u770B\u904E\u88AB\u8712\u4ED4\u54AC\u904E\u7684\u8457\u6D8E\u8336\uFF0C\u4F46\u9019\u6279\u8336\u5F88\u5947\u602A\r\n\u7565\u4ED4\u6709lio\u030Dh-\xE1
      \u016B\u4E00\u6B3E\u751C\u751C\u7684\u82B3\u6C23\t\u7A0D\u5FAE\u6709\u4E00\u7A2E\u751C\u751C\u7684\u9999\u6C23\r\n\u6211\u54A7\u60F3\uFF0C\u70D8\u7126\u4E86\u5F8C\u82B3\u6C23\u82E5\u662F\u95A3\u4F47\u54A7\uFF0C\u7121\u7684\u78BA\u6703\u6709\u7121\u4EDD\u7684\u53E3\u5473\t\u6211\u5728\u60F3\uFF0C\u70D8\u4E7E\u4E4B\u5F8C\uFF0C\u9999\u6C23\u5982\u679C\u9084\u5728\u2026\u8AAA\u4E0D\u5B9A\u6703\u6709\u4E0D\u540C\u7684\u53E3\u5473\r\n\u82E5\u6309\u5462\uFF0C\u4F60\u6599\u60F3\u54B1\u6709\u5E7E\u6210\u7684\u628A\u63E1\t\u5982\u679C\u9019\u6A23\uFF0C\u4F60\u89BA\u5F97\u6211\u5011\u6709\u5E7E\u6210\u7684\u628A\u63E1\r\n\u7B97\u672A\u51FA\u4F86\t\u7B97\u4E0D\u51FA\u4F86\r\n\u4F46\u662F\u6211\u5C31\u662F\u54A7\u5FC3\u5167\u6709\uFE4D\uFE4D\t\u4F46\u662F\u6211\u5C31\u662F\u5167\u5FC3\u6709\u2026\u2026\r\n\u505A\u8336\u5427\uFF0C\u505A\u8336\u5427\t\u505A\u8336\u5427\uFF0C\u505A\u8336\u5427\r\nMr.dodd\t\r\n\u9019\u5473\u9053\u554A\uFF0C\u6216\u8A31\u662F\u4E0D\u8F38\u53F0\u7063\u7684\u70CF\u9F8D\u8336\t\r\n\u4F46\u9019\u8336\u7684\u6A23\u5B50\u554A\uFF0C\u9084\u662F\u8B93\u6211\u89BA\u5F97\u5F88\u5641\u5FC3\t\r\n\u90A3\u5982\u679C\u6211\u5011\u78E8\u6210\u7C89\u5462\t\r\n\u6211\u5011\u7684\u8CB7\u5BB6\u4F4F\u5728\u7D10\u7D04\uFF0C\u4E0D\u662F\u9577\u7426\t\r\n\u8336\u5FC3\u7684\u6210\u54C1\u50B7\u904E\u4180\u77E3\t\u8336\u5FC3\u7684\u6210\u54C1\u592A\u919C\u4E86\r\n\u6211\u7528\u7121\u4EDD\u7684\u65B9\u6CD5\u53BB\u648Bnu\xE1\uFF0C\u770B\u8336\u5FC3\u6562\u6703\u7576\u8F03\u5AA0\u6DE1\u8584\t\u6211\u7528\u4E0D\u540C\u7684\u65B9\u6CD5\u53BB\u63C9\uFF0C\u770B\u8336\u5FC3\u6703\u4E0D\u6703\u6F02\u4EAE\u4E00\u9EDE\r\n\u5594\u5929\u5436\uFF0C\u592A\u82E6\u4E86\t\r\n\u4F46\uFE4D\uFE4D\t\u4F46\uFE4D\uFE4D\r\n\u871C\u82B3\u5DF2\u7D93\u6709\u77E3\uFF0C\u6211\u7565\u4ED4\u6709\u5549\u8457\t\u871C\u9999\u5DF2\u7D93\u51FA\u4F86\u4E86\uFF0C\u6211\u96B1\u7D04\u6709\u559D\u5230\r\n\u9019\u64FA\u5916\u578B\u662F\u6709\u8F03\u5AA0\uFF0C\u4F46\u662F\u648B\u5230\u50B7\u6FDF\u4E88\u82E6\u5473\u650F\u8D70\u51FA\u4F86\u77E3\t\u9019\u6B21\u5916\u578B\u662F\u6709\u6BD4\u8F03\u6F02\u4EAE\uFF0C\u4F46\u662F\u63C9\u592A\u591A\u4E86\uFF0C\u8B93\u82E6\u5473\u90FD\u8DD1\u51FA\u4F86\u4E86\r\n\u6625\u751F\u963F\u5144\uFF0C\u54B1\u52A0\u505A\u5E7E\u64FA\uFF0C\u624D\u8ACB\u6D0B\u5927\u4EBA\t\u6625\u751F\u5144\uFF0C\u6211\u5011\u591A\u505A\u5E7E\u6B21\uFF0C\u518D\u8ACB\u6D0B\u5927\u4EBA\u904E\u4F86\r\n\u8CF0\u4E0A\u5C3E\u9019\u5BE1\u4ED4\u8336\u83DC\u723E\t\u53EA\u5269\u4E0B\u6700\u5F8C\u7684\u4E00\u9EDE\u8336\u8449\u4E86\r\n\u6211\u5BB6\u5DF1\u64D4\u8F38\u8D0F\uFF0C\u8ACB\u6D0B\u5927\u4EBA\u63D0\u69CD\u904E\u4F86\t\u6211\u81EA\u5DF1\u627F\u64D4\u8F38\u8D0F\uFF0C\u8ACB\u6D0B\u5927\u4EBA\u62FF\u69CD\u904E\u4F86\r\n\u9B4F\u5C0F\u59D0\uFF0C\u90A3\u500B\u2026
      \u89C0\u3001\u805E\u3001\u6478\u3001\u7167\uFF0C\u662F\u4EC0\u9EBC\u610F\u601D\t\u9B4F\u5C0F\u59D0\uFF0C\u90A3\u500B\u2026
      \u89C0\u3001\u805E\u3001\u6478\u3001\u7167\uFF0C\u662F\u4EC0\u9EBC\u610F\u601D\r\n\u8336\u7684\u5AA0\uFF0C\u54A7\u76EE\u776D\u770B\u8457\u8336\u5FC3\u7684\u6642\u9663\uFF0C\u9F3B\u5B50\u9F3B\u5230\u8336\u5FC3\u7684\u6642\u9663\uFF0C\u624B\u638C\u6478\u5230\u8336\u5FC3\u7684\u6642\u9663\t\u8336\u7684\u7F8E\uFF0C\u5728\u65BC\u770B\u5230\u8336\u5FC3\u7684\u6642\u5019\uFF0C\u9F3B\u5B50\u805E\u5230\u8336\u5FC3\u7684\u6642\u5019\uFF0C\u624B\u638C\u6478\u5230\u8336\u5FC3\u7684\u6642\u5019\r\n\u7B49\u4E00\u54A7\uFF0C\u89C0\u3001\u805E\t\u7B49\u4E00\u4E0B\u2026\u89C0\u3001\u805E\r\n\u4ECA\u561B\u54B1\u7684\u65B0\u8336\uFF0C\u8336\u5FC3\u81EA\u672C\u7684\u871C\u82B3\u7121\u8B1B\u84CB\u5F37\t\u73FE\u5728\uFF0C\u6211\u5011\u7684\u65B0\u8336\uFF0C\u8336\u65B0\u672C\u8EAB\u7684\u871C\u9999\u4E0D\u662F\u5F88\u5F37\r\n\u4F46\u662F\u54E9\uFF0C\u6EFE\u6C34\u6C96\u843D\u53BB\u4E86\u5F8C\uFF0C\u563F\u54E9\u751C\u871C\u7684\u82B3\u6C23\u650F\u5DF2\u7D93\u8AA0\u660E\u986F\u77E3\t\u4F46\u662F\u5462\uFF0C\u6EFE\u6C34\u6C96\u958B\u4E4B\u5F8C\uFF0C\u90A3\u500B\u751C\u871C\u7684\u9999\u6C23\u5C31\u5F88\u660E\u986F\r\n\u6240\u4EE5\u9F41\uFF0C\u6211\u76F8\u4FE1\u4F9B\uFF0C\u4F60\u4E00\u5B9A\u6709\u751A\u9EBC\u6487\u6B65\t\u6240\u4EE5\u6211\u76F8\u4FE1\u5462\uFF0C\u4F60\u4E00\u5B9A\u6709\u751A\u9EBC\u79D8\u8A23\r\n\u6B38\u7576\u4E4E\u8336\u5FC3\u7121\u5195\u6CE1\uFF0C\u554A\u5B83\u7684\u5BC6\u82B3\u5C31\u767C\u5F97\u6EFF\u6EFF\u662F\t\u80FD\u5920\u8B93\u8336\u5FC3\u4E0D\u7528\u6CE1\uFF0C\u5C31\u53EF\u4EE5\u6563\u767C\u51FA\u4ED6\u7684\u871C\u9999\r\n\u963F\u96F2\u4ED4\uFF0C\u8336\u5FC3\u8F03\u4180\u78BA\u5BE6\u53EF\u80FD\u7121\u92B7\u8DEF\t\u963F\u96F2\u4ED4\uFF0C\u8336\u5FC3\u8F03\u919C\u78BA\u5BE6\u53EF\u80FD\u6C92\u6709\u92B7\u8DEF\r\n\u4F46\u662F\uFF0C\u89C0\u3001\u805E\uFF0C\u4EDD\u6B3E\u91CD\u8981\uFF0C\u6562\u6BCB\u662F\t\u4F46\u662F\uFF0C\u89C0\u3001\u805E\uFF0C\u540C\u6A23\u91CD\u8981\uFF0C\u4E0D\u662F\u55CE\r\n\u597D\uFF0C\u54B1\u95A3\u4F86\t\u597D\uFF0C\u6211\u5011\u518D\u4F86\r\n\u6625\u751F\u963F\u5144\uFF0C\u6211\u6B32\u91CD\u4F86\t\u6625\u751F\u5144\uFF0C\u6211\u8981\u91CD\u4F86\r\n\u54B1\u9019\u64FA\u63C0\u4E00\u5FC3\u4E8C\u8449\uFF0C\u7121\u8336\u679D\u7684\u8336\u9752\t\u6211\u5011\u9019\u6B21\u9078\u4E00\u5FC3\u4E8C\u8449\uFF0C\u7121\u8336\u679D\u7684\u8336\u9752\r\n\u6709\u77E3\uFF0C\u8DB3\u82B3\t\u6709\u4E86\uFF0C\u9019\u6B21\u6709\u4E86\uFF0C\u5F88\u9999\r\n\u8DB3\u82B3\t\u5F88\u9999\r\n\u771F\u7684\u8DB3\u82B3\t\u771F\u7684\u5F88\u9999\r\n\u4F60\u52A0\u4E86\u8702\u871C\t\r\n\u9084\u662F\u4EC0\u9EBC\u7279\u6B8A\u7684\u82B1\u74E3\t\r\n\u6211\u525B\u5F9E\u4E00\u9032\u4F86\u5C31\u805E\u5230\u4E00\u80A1\u597D\u7279\u5225\u7684\u9999\u5473\t\r\n\u5C31\u662F\u9019\u500B\u9999\u5473\t\r\n\u53C8\u50CF\u82B1\u6735\u53C8\u50CF\u6C34\u679C\uFF0C\u53C8\u50CF\u8336\u8449\t\r\n\u6211\u7576\u7136\u5BB9\u8A31\u4F60\u5011\u52A0\u5165\u5176\u4ED6\u6771\u897F\uFF0C\u4F86\u505A\u51FA\u9019\u7A2E\u7F8E\u5999\u7684\u5473\u9053\t\r\n\u6211\u4E0D\u6703\u751F\u6C23\u7684\uFF0C\u8B93\u6211\u770B\u770B\u4F60\u5011\u6DFB\u52A0\u4E86\u751A\u9EBC\u5427\t\r\n\u4EC0\u9EBC\uFF0C\u9019\u4E0D\u5C31\u662F\u539F\u4F86\u7684\u90A3\u7A2E\u8336\u8449\u55CE\t\r\n\u4E0D\u904E\u8AAA\u771F\u7684\uFF0C\u805E\u8457\u9019\u80A1\u9999\u6C23\uFF0C\u7684\u78BA\u8B93\u6211\u8D8A\u770B\u5B83\u8D8A\u9806\u773C\t\r\n\u90A3\uFF0C\u5C31\u9EBB\u7169\u9676\u5FB7\u5148\u751F\u554A\t\r\n\u591A\u5411\u6211\u5011\u7684\u897F\u6D0B\u8CB7\u5BB6\u63A8\u85A6\u9019\u6B3E\u65B0\u8336\t\r\n\u6211\u76F8\u4FE1\u554A\uFF0C\u4ED6\u5011\u4E00\u6253\u958B\u5305\u88F9\t\r\n\u4E00\u5B9A\u99AC\u4E0A\u5C31\u6703\u88AB\u9019\u500B\u8336\u8449\u7684\u9999\u6C23\u7D66\u8FF7\u4F4F\u7684\uFF0C\u5C31\u8DDF\u4F60\u4E00\u6A23\t\r\n\u4F60\u7336\u672A\u5549\uFF0C\u8ACB\t\u4F60\u9084\u6C92\u559D\u5462\uFF0C\u8ACB\r\n\u9019\u662F\u6211\u4E00\u4E16\u4EBA\uFF0C\u5F9E\u4F86\u6C92\u6709\u611F\u53D7\u904E\u7684\u82B3\u5473\t\u9019\u662F\u6211\u9019\u8F29\u5B50\uFF0C\u5F9E\u4F86\u6C92\u6709\u611F\u53D7\u904E\u7684\u9999\u5473\r\n\u4F60\u5011\u8B1B\uFF0C\u82F1\u570B\u5973\u738B\u6703\u4E0D\u6703\u559C\u6B61\u6211\u5011\u9019\u7A2E\u8336\t\r\n\u4F60\u5011\u559D\u904E\u8336\u4E86\u5427\t\r\n\u6709\u6C92\u6709\u54C1\u5617\u51FA\u4E00\u7A2E\u53C8\u50CF\u6C34\u679C\u9999\uFF0C\u53C8\u50CF\u82B1\u871C\u7684\u7518\u751C\t\r\n\u674E\u6625\u751F\u53E3\u4E2D\uFF0C\u5F9E\u4F86\u6C92\u6709\u904E\u7684\u5473\u9053\uFF0C\u5C31\u662F\u9019\u500B\t\r\n\u6E05\u6CD5\u6230\u722D\u671F\u9593\uFF0C\u8336\u8449\u6EEF\u92B7\uFF0C\u8336\u8FB2\u5931\u53BB\u7167\u9867\u8336\u5712\u7684\u5FC3\u529B\t\r\n\u4E00\u7A2E\u53EB\u5C0F\u7DA0\u8449\u87EC\u7684\u5BB3\u87F2\uFF0C\u559C\u6B61\u4EE5\u8336\u6A39\u7684\u5AE9\u8449\u70BA\u98DF\t\r\n\u88AB\u98DF\u7528\u904E\u7684\u5AE9\u8449\u6A23\u8C8C\u6975\u70BA\u919C\u964B\uFF0C\u50CF\u751F\u75C5\u4E00\u6A23\u8737\u66F2\u8D77\u4F86\t\r\n\u8336\u4EBA\u53EB\u9019\u4E9B\u5AE9\u8449\u300C\u8457\u6D8E\u8336\u300D\t\r\n\u5728\u6B64\u4E4B\u524D\uFF0C\u90FD\u662F\u7576\u4F5C\u52A3\u8CEA\u54C1\u5728\u5EC9\u50F9\u8CA9\u8CE3\t\r\n\u674E\u6625\u751F\u548C\u9676\u5FB7\uFF0C\u4E00\u958B\u59CB\u90FD\u975E\u5E38\u7684\u4E0D\u4E86\u89E3\u9B4F\u82B7\u96F2\u70BA\u4EC0\u9EBC\u8981\u63A5\u6536\u9019\u6279\u52A3\u8CEA\u8336\t\r\n\u4E26\u4E14\u5982\u6B64\u7D30\u5FC3\u5730\u5C0D\u5F85\u5B83\u5011\t\r\n\u800C\u6211\uFF0C\u4E5F\u53EA\u80FD\u731C\t\r\n\u6211\u731C\u8336\u4ED9\u5B50\u9B4F\u82B7\u96F2\uFF0C\u5979\u6DF1\u523B\u4E86\u89E3\u7576\u4E00\u7247\u8336\u8449\t\r\n\u5F9E\u8336\u6A39\u4E0A\u6458\u4E0B\u5230\u8B93\u6EFE\u6C34\u716E\u51FA\u5B83\u81EA\u5DF1\u7684\u5473\u9053\uFF0C\u4E2D\u9593\u6B77\u7D93\u4E86\u591A\u5C11\u78E8\u96E3\t\r\n\u904E\u7A0B\u4E2D\u5F80\u5F80\u6709\u8A31\u591A\u4E0D\u5B8C\u7F8E\u7684\u6642\u523B\uFF0C\u800C\u5979\u8A66\u5716\u5728\u4E0D\u5B8C\u7F8E\u4E2D\u627E\u5230\u4E86\u5B8C\u7F8E\t\r\n\u88FD\u8336\u4E2D\u7684\u6BCF\u4E00\u6B65\uFF0C\u90FD\u53EF\u80FD\u8B93\u9019\u7247\u8336\u8449\u6563\u767C\u51FA\u610F\u60F3\u4E0D\u5230\u7684\u7F8E\u5473\t\r\n\u5B9B\u82E5\u4EBA\u751F\t